<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.DoesTheDogDie</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <DtddClientPath Condition="'$(DtddClientPath)' == ''">../../../dtdd-client</DtddClientPath>
    <DtddClientVersion Condition="'$(DtddClientVersion)' == ''">0.1.0</DtddClientVersion>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(DtddClientPath)/src/DoesTheDogDie/DoesTheDogDie.csproj')">
    <ProjectReference Include="$(DtddClientPath)/src/DoesTheDogDie/DoesTheDogDie.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(DtddClientPath)/src/DoesTheDogDie/DoesTheDogDie.csproj')">
    <PackageReference Include="DtDDNetClient" Version="$(DtddClientVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.DoesTheDogDie.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" >
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <!-- Jellyfin's PluginManager loads every *.dll it finds recursively under a plugin's directory as a
       managed assembly, so SQLitePCLRaw's native Windows libraries (runtimes/win-*/native/e_sqlite3.dll)
       throw BadImageFormatException and get the whole plugin disabled. Only *.dll under runtimes/*/native
       is removed: the .so/.dylib payloads are never scanned and the Linux .so is what makes the SQLite
       cache work on a real server. Without the natives, the cache falls back to in-memory. -->
  <Target Name="RemoveNativeWindowsLibrariesFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <NativeWindowsLibrariesToRemove Include="$(PublishDir)runtimes\*\native\*.dll" />
    </ItemGroup>
    <Delete Files="@(NativeWindowsLibrariesToRemove)" />
  </Target>

</Project>
